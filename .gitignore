__pycache__/
*.pyc

# Intermediate extraction output -- regenerable from uploads/*.pdf via the
# app's "Process"/"Re-run" button (extract.py + normalize.py). chunks/ is the
# frozen, curated corpus and IS tracked; raw/ and clean/ are not.
raw/
clean/

# Transient upload staging file (app.py writes this, then renames it away)
.upload_*.tmp.pdf
.new_handbook.tmp.pdf

# Working search index -- rebuilt from chunks/ by build_index.py, used for
# experiments. The TESTED index that the chatbot serves is committed to the
# chatbot repo as index_v1/, index_v2/, ... (see INDEX_README.md).
index/
index_*/

# Secrets (GLM API key etc.) -- never commit
.env
